{
  "name": "buildx-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "BUILDX local-first desktop development environment",
  "main": "desktop/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on tcp:5173 && cross-env BUILDX_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --ext .js,.jsx,.cjs,.mjs desktop/electron desktop/renderer/src *.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "vite": "^8.3.4",
    "vitest": "^4.0.8",
    "wait-on": "^8.0.4"
  }
}
