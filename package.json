{
  "name": "buildx-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "BUILDX local-first desktop development environment",
  "main": "desktop/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on tcp:5173 && cross-env BUILDX_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --ext .js,.jsx,.cjs,.mjs desktop/electron desktop/renderer/src *.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "vite": "^8.3.4",
    "vitest": "4.1.12",
    "wait-on": "^8.0.4"
  }
}
